# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.
# Valores que contienen "$" (los hashes) deben ir entre comillas simples.

APP_ENV=production
# Dominio público que apunta al servidor. Lo usa Caddy para TLS automático.
# Para pruebas locales: APP_DOMAIN=localhost (Caddy usa su CA interna).
APP_DOMAIN=
APP_TIMEZONE=UTC

# Superusuario/bootstrap de PostgreSQL: solo lo usan el contenedor db y los scripts de backup.
# El contenedor app NO lo recibe.
POSTGRES_DB=formmanager
POSTGRES_USER=formmanager_bootstrap
# Genera con: openssl rand -hex 32
POSTGRES_PASSWORD=

# Rol de la aplicación (sin superusuario, dueño solo de su base de datos).
APP_DB_USER=formmanager_app
# Genera con: openssl rand -hex 32
APP_DB_PASSWORD=

# Opcional. Si se deja vacío, la app construye la URL con APP_DB_USER/APP_DB_PASSWORD y host "db".
DATABASE_URL=

# Un único administrador definido por entorno.
ADMIN_USERNAME=
# Genera con: docker compose run --rm --no-deps app python -m app.security.generate_hash
ADMIN_PASSWORD_HASH=
# Genera con: openssl rand -hex 48
SESSION_SECRET=

ADMIN_LOGIN_RATE_LIMIT=5/15minutes
# Duración absoluta de la sesión de administrador (segundos, 300-86400).
SESSION_MAX_AGE_SECONDS=14400

LOG_LEVEL=INFO

# Opcionales (valores por defecto seguros).
# MAX_REQUEST_BODY_BYTES=16384
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=10000
# Tamaño máximo de cada archivo de definición de formulario (bytes).
# FORM_DEFINITION_MAX_BYTES=1048576

# Dentro del contenedor FORMS_DIR es siempre /data/forms (volumen forms_data).
# Cada subdirectorio es un paquete de formulario; se escanea al arrancar (ver FORM_SCHEMA.md).
